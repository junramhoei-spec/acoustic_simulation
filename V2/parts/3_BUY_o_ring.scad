// =========================================================================
// [구매] 피스톤 실링용 오링 (O-Ring) × 1개
// 규격: ø100mm 실린더 보어 대응 (홈 바닥 ø93.0mm, 단면 선경 ø4.8mm)
// 재질: NBR 또는 실리콘 고무 (검은색)
// 용도: 컵 피스톤 외주면 실링 및 기밀 유지
// =========================================================================
include <_params.scad>

ORING_W = 4.8;
ORING_GROOVE_D = 93.0;

color([0.15, 0.15, 0.15, 1.0]) {
    rotate_extrude($fn = 80) {
        translate([(ORING_GROOVE_D + CUP_ID) / 4, 0, 0])
            circle(d = ORING_W, $fn = 30);
    }
}
